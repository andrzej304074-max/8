# ── Baza danych ───────────────────────────────────────────────────────────────
# Lokalnie (npm run dev): zostaw wartość domyślną — baza to plik na dysku.
# Na Vercel: wklej adres libsql://... z panelu Turso oraz token poniżej.
DATABASE_URL="file:./data/dev.db"
DATABASE_AUTH_TOKEN=""

# ── Logowanie do aplikacji ────────────────────────────────────────────────────
# Sekret podpisujący cookie sesji: dowolny losowy tekst, MINIMUM 32 znaki.
# Wygenerujesz go komendą:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Hasło, którym logujesz się do aplikacji w przeglądarce (minimum 8 znaków).
APP_PASSWORD=""

# ── Zdjęcia ───────────────────────────────────────────────────────────────────
# Lokalnie zostaw puste — zdjęcia trafiają do folderu data/uploads.
# Na Vercel: w projekcie utwórz Blob store (zakładka Storage → Create → Blob);
# Vercel sam doda tę zmienną do środowiska produkcyjnego.
BLOB_READ_WRITE_TOKEN=""

# ── Generowanie ogłoszeń przez AI (Gemini) ────────────────────────────────────
# Darmowy klucz: https://aistudio.google.com → Get API key → Create API key.
# Puste = przycisk generowania pokaże instrukcję zamiast działać.
GEMINI_API_KEY=""
# Model można podmienić bez zmian w kodzie (np. na nowszy z rodziny Flash).
GEMINI_MODEL="gemini-2.5-flash"
